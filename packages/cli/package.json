{
  "name": "devlaunch",
  "version": "0.0.0",
  "description": "Turn any local dev server into a macOS app you launch from Spotlight.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devlaunch": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=18.20.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["devlaunch", "macos", "spotlight", "dev-server", "launcher", "cli"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --silent --onSuccess \"node ./dist/index.js\"",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@devlaunch/core": "workspace:*",
    "@devlaunch/runtime": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
