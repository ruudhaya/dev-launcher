<?xml version="1.0" encoding="UTF-8"?>
<!--
  devlaunch Info.plist template.

  @devlaunch/core (see src/bundle) fills in the tokens below per project at
  generate time via a plain substitutePlaceholders() text replacement — no
  templating engine, so every token must appear literally as TOKEN_NAME
  wrapped in double underscores. CFBundleExecutable, CFBundleVersion, and
  CFBundleShortVersionString are static; the shell script this bundle points
  at (Contents/MacOS/launcher) is still a placeholder until a later change.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>__PROJECT_NAME__</string>
  <key>CFBundleDisplayName</key>
  <string>__PROJECT_NAME__</string>
  <key>CFBundleIdentifier</key>
  <string>dev.devlaunch.__PROJECT_SLUG__</string>
  <key>CFBundleVersion</key>
  <string>0</string>
  <key>CFBundleShortVersionString</key>
  <string>0.0.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleExecutable</key>
  <string>launcher</string>
  <!-- No extension, per Apple's documented CFBundleIconFile convention — the
       actual resource is Contents/Resources/icon.icns. -->
  <key>CFBundleIconFile</key>
  <string>icon</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <!--
    true for headless launchers (no Dock icon while the server runs), false for
    terminal mode. Kept a real, valid boolean here, not a placeholder token, so
    this file stays valid plist XML on its own; @devlaunch/core flips true/false
    with a targeted string replace (see setLsUiElementHeadless in src/bundle)
    rather than the generic substitution used for the string fields below.
  -->
  <key>LSUIElement</key>
  <true/>
  <!-- The devlaunch version that generated this bundle — read by `devlaunch upgrade` (later) to
       tell whether a launcher needs regenerating. -->
  <key>DevlaunchVersion</key>
  <string>__DEVLAUNCH_VERSION__</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
