<?xml version="1.0" encoding="UTF-8"?>
<!--
  devlaunch Info.plist — PLACEHOLDER

  @devlaunch/core fills the __PLACEHOLDER__ tokens per project at generate time.
  Kept minimal but valid so plist parsers and future template tests have something
  real to check.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>__PROJECT_NAME__</string>
  <key>CFBundleDisplayName</key>
  <string>__PROJECT_NAME__</string>
  <key>CFBundleIdentifier</key>
  <string>dev.devlaunch.__PROJECT_SLUG__</string>
  <key>CFBundleVersion</key>
  <string>0</string>
  <key>CFBundleShortVersionString</key>
  <string>0.0.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleExecutable</key>
  <string>launcher</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
