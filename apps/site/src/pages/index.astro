---
// Placeholder marketing landing page. Real copy is driven by marketing/messaging.md
// (created in a later session) and this page will be rebuilt then.
const title = 'devlaunch';
const tagline = 'Turn any local dev server into a macOS app you launch from Spotlight.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {tagline}</title>
    <meta name="description" content={tagline} />
    <style>
      :root { color-scheme: light dark; }
      body {
        font: 16px/1.6 system-ui, sans-serif;
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-content: center;
        text-align: center;
        padding: 2rem;
        gap: 0.5rem;
      }
      h1 { font-size: clamp(2rem, 6vw, 3.5rem); margin: 0; }
      p { max-width: 40ch; margin: 0 auto; opacity: 0.8; }
      a { color: inherit; }
    </style>
  </head>
  <body>
    <h1>{title}</h1>
    <p>{tagline}</p>
    <p><a href="/docs/">Read the docs →</a></p>
    <p><small>Placeholder site — the real one lands later.</small></p>
  </body>
</html>
